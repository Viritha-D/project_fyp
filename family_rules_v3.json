  "stem": {
    "_description": "Same stem as v2: lowercase (spelling_us), remove parenthetical text, keep alphabetic tokens and 4-digit years, drop numbers, F/G numbers, size tokens, instance ids and drop_words. A stem shorter than min_stem_chars or generic gives no key (short series names are handled by standard_suites). Family name = the stem.",
    "parenthetical_regex": "\\([^()]*\\)|\\[[^\\[\\]]*\\]",
    "token_regex": "[a-z]+|\\d+",
    "year_regex": "^(199\\d|20[0-3]\\d)$",
    "size_token_regex": "^(\\d+d|\\d+x\\d+|n|m|k|d|bit|bits|buoy|nodes?|cities|jobs|clusters?|variables?|dims?|dimensions?)$",
    "drop_words": [
      "instance",
      "instances",
      "function",
      "functions",
      "suite",
      "benchmark",
      "benchmarks",
      "test",
      "the",
      "set",
      "ieee",
      "problem",
      "problems",
      "f",
      "g",
      "a",
      "an",
      "of",
      "on",
      "for",
      "and",
      "with"
    ],
    "min_stem_chars": 4,
    "generic_stems": [
      "task",
      "dataset",
      "data",
      "model",
      "scenario",
      "case",
      "case study",
      "setting",
      "experiment",
      "instance",
      "real world",
      "synthetic"
    ]
  },
