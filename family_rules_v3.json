  "template": {
    "_description": "Within one Category: names with >= min_tokens tokens whose tokens CONTAINING DIGITS are identical (same sequence) and whose other tokens differ by <= max_token_edits insertions / deletions / substitutions. Connected components of such pairs (among entities without a suite or stem key) form template groups. Family name = the tokens all members share, with {...} marking the varying part.",
    "min_tokens": 5,
    "max_token_edits": 2,
    "digit_tokens_identical": true
  },
  "library_cue": {
    "_description": "A cue on the entity's rows (Dataset_Name / Source_Platform); the entity's cue is the one on most rows (ties: list order). Used as a family key only in the last pass. Every cue on an entity's rows is also recorded as suite_memberships (cue + paper count), an attribute, never a merge. Family name = '<cue> datasets (<most common Problem_Context by papers>)'.",
    "cues": [
      {
        "cue": "CEC {year}",
        "regex": "\\bcec[\\s\\-']*(\\d{4}|\\d{2})\\b"
      },
      {
        "cue": "BBOB",
        "regex": "\\bbbob\\b|\\bcoco\\s*(platform|framework|bbob)"
      },
      {
        "cue": "TSPLIB",
        "regex": "\\btsp\\s*lib"
      },
      {
        "cue": "QAPLIB",
        "regex": "\\bqap\\s*lib"
      },
      {
        "cue": "CVRPLIB",
        "regex": "\\bcvrp\\s*lib"
      },
      {
        "cue": "OR-Library",
        "regex": "\\bor[\\s\\-]*lib(rary)?\\b"
      },
      {
        "cue": "UCI",
        "regex": "\\buci\\b"
      },
      {
        "cue": "OpenML",
        "regex": "\\bopenml\\b"
      },
      {
