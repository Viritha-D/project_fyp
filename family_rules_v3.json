{
  "_about": "Family layer rules, v3. Each entity gets exactly ONE family key by priority (standard_suite > stem > template > library_cue); a family is the set of entities sharing that key. No union across rules, so no chaining. Entities, ids, notes and embeddings are never changed. Embedding similarity never merges. Regexes are Python, case-insensitive.",
  "primary_key": {
    "_description": "Assigned in passes. Pass 1: every entity whose canonical name matches a standard suite gets that suite key (even if alone). Pass 2-4, over the entities still without a key: a stem key, a template group or a library cue is used only when at least 2 such entities share it. Anything left is 'single'. Suite and stem keys ignore Category (a family may be 'mixed'); template and library-cue keys stay within one Category.",
    "priority": [
      "standard_suite",
      "stem",
      "template",
      "library_cue"
    ],
    "cross_category": [
      "standard_suite",
      "stem"
    ],
    "family_kind": {
      "standard_suite": "suite_series",
      "stem": "stem_group",
      "template": "template_grid",
      "library_cue": "repository_collection",
      "single": "single"
    }
  },
  "standard_suites": {
    "_description": "The suite key is set directly by these patterns on the canonical name, regardless of stem length, at any position (so 'Sharp Ridge (BBOB F13)' and 'BBOB F13 (Sharp Ridge)' both get 'bbob'). If several match, the one that appears first in the name wins (ties: list order). CEC keys keep the year (CEC'13 / CEC 2013 / CEC-2013 -> cec_2013). Bare TSPLIB / QAPLIB instance names (instance_ids) get tsplib / qaplib.",
    "suites": [
      {
        "key": "cec_{year}",
        "name": "CEC {year} suite",
        "regex": "\\bcec[\\s\\-']*(\\d{4}|\\d{2})\\b"
      },
      {
        "key": "bbob",
        "name": "BBOB (COCO)",
        "regex": "\\bbbob\\b|\\bcoco\\s*(/|bbob|benchmark|suite)"
      },
      {
        "key": "dtlz",
        "name": "DTLZ",
        "regex": "\\bdtlz"
      },
      {
        "key": "zdt",
        "name": "ZDT",
        "regex": "\\bzdt"
      },
      {
        "key": "wfg",
        "name": "WFG",
        "regex": "\\bwfg"
      },
      {
        "key": "uf",
        "name": "UF (CEC 2009 unconstrained)",
        "regex": "\\buf\\s*\\d+\\b"
      },
      {
        "key": "maf",
        "name": "MaF",
        "regex": "\\bmaf\\b|\\bmaf\\s*\\d+"
      },
      {
        "key": "lsmop",
        "name": "LSMOP",
        "regex": "\\blsmop"
      },
      {
        "key": "dascmop",
        "name": "DASCMOP",
        "regex": "\\bdascmop"
      },
      {
        "key": "mw",
        "name": "MW",
        "regex": "\\bmw\\s*\\d+\\b|\\bmw\\s+suite\\b"
      },
      {
        "key": "lz09",
        "name": "LZ09",
        "regex": "\\blz\\s*0?\\d\\s*-\\s*lz\\s*0?\\d|\\blz09\\b"
      },
      {
        "key": "onemax",
        "name": "OneMax",
        "regex": "\\bone\\s*max\\b"
      },
      {
        "key": "leadingones",
        "name": "LeadingOnes",
        "regex": "\\bleading\\s*ones\\b"
      },
      {
        "key": "twomax",
        "name": "TwoMax",
        "regex": "\\btwo\\s*max\\b"
      },
      {
        "key": "jump",
        "name": "Jump",
        "regex": "\\bjump(_?k|k|offset\\w*)?\\b"
      },
      {
        "key": "trap",
        "name": "Trap",
        "regex": "\\btrap\\b"
      },
      {
        "key": "nk_landscape",
        "name": "NK landscape",
        "regex": "\\bnk[\\s\\-]*landscapes?\\b"
      },
      {
        "key": "mstsp",
        "name": "MSTSP",
        "regex": "\\bmstsp"
      },
      {
        "key": "rwmop",
        "name": "RWMOP (CEC 2021 real-world MOPs)",
        "regex": "\\brwmop"
      },
      {
        "key": "moving_peaks",
        "name": "Moving Peaks",
        "regex": "\\bmoving\\s+peaks\\b|\\bmpb\\b"
      },
      {
        "key": "tsplib",
        "name": "TSPLIB",
        "regex": "\\btsp\\s*lib\\b"
      },
      {
        "key": "qaplib",
        "name": "QAPLIB",
        "regex": "\\bqap\\s*lib\\b"
      },
      {
        "key": "psb2",
        "name": "PSB2",
        "regex": "\\bpsb2\\b"
      }
    ]
  },
  "spelling_us": {
    "_description": "British -> American word map, applied to lowercased names before stems, templates and the duplicate check.",
    "travelling": "traveling",
    "travelled": "traveled",
    "modelling": "modeling",
    "modelled": "modeled",
    "labelling": "labeling",
    "labelled": "labeled",
    "optimisation": "optimization",
    "optimisations": "optimizations",
    "optimise": "optimize",
    "optimised": "optimized",
    "optimiser": "optimizer",
    "minimisation": "minimization",
    "maximisation": "maximization",
    "minimise": "minimize",
    "maximise": "maximize",
    "generalisation": "generalization",
